<?xml version="1.0" encoding="UTF-8"?>
<!--
  BeautySalonApp — Dekont şablonu (plan §10.6: "Dekont tasarımcısı: firmaya özel şablon
  (logo, alanlar, dipnot)"). Bu dosya kurulumda <dataDir>/config/reports/dekont.jrxml
  altına kopyalanır ve orada müşteriye özel biçimde DÜZENLENEBİLİR — uygulama
  güncellemesi bu kopyanın üzerine yazmaz (bkz. VoucherService).

  Türkçe karakter desteği için varsayılan yazı tipi SansSerif (JVM gömülü) kullanılır;
  özel bir font gerekiyorsa <reportFont> ekleyip pdfFontName ayarlayın.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="dekont" pageWidth="298" pageHeight="420" columnWidth="278"
              leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10"
              uuid="8f2b1a2e-1c3d-4a5e-9b6f-0d1e2f3a4b5c">

    <parameter name="isletmeAdi" class="java.lang.String"/>
    <parameter name="dekontNo" class="java.lang.String"/>
    <parameter name="tarih" class="java.lang.String"/>
    <parameter name="tur" class="java.lang.String"/>
    <parameter name="hesap" class="java.lang.String"/>
    <parameter name="karsiTaraf" class="java.lang.String"/>
    <parameter name="aciklama" class="java.lang.String"/>
    <parameter name="tutar" class="java.lang.String"/>
    <parameter name="dipnot" class="java.lang.String"/>

    <title>
        <band height="70">
            <staticText>
                <reportElement x="0" y="0" width="278" height="24"/>
                <textElement textAlignment="Center">
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[DEKONT]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="26" width="278" height="18"/>
                <textElement textAlignment="Center">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{isletmeAdi}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="50" width="278" height="1"/>
            </line>
            <textField>
                <reportElement x="0" y="54" width="140" height="16"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Dekont No: " + $P{dekontNo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="140" y="54" width="138" height="16"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Tarih: " + $P{tarih}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <detail>
        <band height="150">
            <textField>
                <reportElement x="0" y="0" width="278" height="18"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["İşlem Türü: " + $P{tur}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="20" width="278" height="18"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA["Hesap: " + $P{hesap}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="0" y="40" width="278" height="18"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{karsiTaraf} == null || $P{karsiTaraf}.isEmpty() ? "" : ("Karşı Taraf: " + $P{karsiTaraf})]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="0" y="60" width="278" height="36"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA["Açıklama: " + $P{aciklama}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="100" width="278" height="1"/>
            </line>
            <textField>
                <reportElement x="0" y="104" width="278" height="26"/>
                <textElement textAlignment="Center">
                    <font size="16" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{tutar}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="40">
            <textField textAdjust="StretchHeight">
                <reportElement x="0" y="4" width="278" height="30"/>
                <textElement textAlignment="Center">
                    <font size="7" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{dipnot}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
