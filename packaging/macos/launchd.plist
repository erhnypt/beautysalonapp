<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS launchd daemon — ALTERNATİF yol.

  jpackage 21+ `--launcher-as-service` bu plist'i /Library/LaunchDaemons altına
  kendisi kurar (build-all.sh varsayılanı). Elle kurulum / özelleştirme için referans:

    sudo cp launchd.plist /Library/LaunchDaemons/com.beautysalonapp.app.plist
    sudo launchctl load -w /Library/LaunchDaemons/com.beautysalonapp.app.plist

  Yol varsayımı: /Applications/BeautySalonApp.app (§5.2).

  Şifreleme anahtarı System Keychain'e taşındıysa (F3, bkz.
  packaging/scripts/wrap-crypto-key-macos.sh) ProgramArguments'ı ikili yerine
  launch-wrapper-macos.sh'a yönlendirin — wrapper anahtarı keychain'den okuyup
  -Dbeautysalonapp.crypto.key-base64 olarak geçirir, sonra ikiliyi çalıştırır:

    <string>/Applications/BeautySalonApp.app/Contents/Resources/launch-wrapper-macos.sh</string>

  Servisi root yerine az yetkili bir hesapla çalıştırmak için (I1) bkz.
  packaging/scripts/harden-macos.sh — bu betik UserName anahtarını buraya ekler.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.beautysalonapp.app</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Applications/BeautySalonApp.app/Contents/MacOS/BeautySalonApp</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>SPRING_PROFILES_ACTIVE</key>
        <string>packaged</string>
        <key>JAVA_TOOL_OPTIONS</key>
        <string>-Dbeautysalonapp.packaged=true -Xss1m -XX:MaxRAMPercentage=50</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Library/Application Support/BeautySalonApp/logs/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Application Support/BeautySalonApp/logs/stderr.log</string>

    <key>ProcessType</key>
    <string>Background</string>
    <key>Nice</key>
    <integer>1</integer>
</dict>
</plist>
